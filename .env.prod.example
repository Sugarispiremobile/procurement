# Скопируйте в .env рядом с docker-compose.prod.yml
DOMAIN=zayavki.company.kz
POSTGRES_PASSWORD=замените-длинным-паролем
JWT_SECRET=замените-случайной-строкой-не-короче-32-символов
ALLOWED_EMAIL_DOMAIN=
CURRENCY=₸
APP_TZ=Asia/Almaty
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Заявки в снабжение <no-reply@company.kz>

# Резервные копии (см. deploy/backup.sh). Копии, лежащие только на этом сервере, не защищают от потери сервера —
# настройте копирование вовне и оповещение об ошибках.
BACKUP_HOUR=03
# Команда копирования вовне; пути файлов — в $BACKUP_FILES. Пример (ключ положите в deploy/ssh/id_ed25519):
# BACKUP_UPLOAD_CMD=rsync -a -e "ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=accept-new" $BACKUP_FILES backup@host:/srv/procurement/
BACKUP_UPLOAD_CMD=
# URL вебхука для сообщения об ошибке копии (POST, поле text) и URL «копия выполнена» (например, healthchecks.io)
BACKUP_ALERT_URL=
BACKUP_OK_URL=
