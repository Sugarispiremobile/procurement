# Скопируйте в .env и заполните
DATABASE_URL=postgres://procurement:procurement@localhost:5432/procurement
# Длинная случайная строка, например: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=замените-на-длинную-случайную-строку
JWT_EXPIRES_IN=8h
PORT=3000
NODE_ENV=development

# Часовой пояс, в котором считается «сегодня» (даты «нужно к», просрочка)
APP_TIMEZONE=Asia/Almaty

# Если сервис стоит за обратным прокси (nginx и т.п.) — число прокси, обычно 1. Без прокси оставьте пустым,
# иначе клиент сможет подделать свой IP через X-Forwarded-For.
TRUST_PROXY=

# Регистрация только с этих почтовых доменов через запятую, например: company.kz,company.com
# Пусто — регистрироваться может любой. Для рабочего развёртывания задайте обязательно.
ALLOWED_EMAIL_DOMAINS=

# Первый администратор (создаётся при npm run db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=смените-пароль-12345
ADMIN_NAME=Администратор

# 1 — добавить демо-пользователей и демо-заявки из прототипа (только для разработки)
SEED_DEMO=1
