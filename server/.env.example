# Скопируйте в .env и заполните (npm run setup делает это сам)
DATABASE_URL=postgres://procurement:procurement@localhost:5432/procurement
# Длинная случайная строка (≥ 32 символов в production): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=замените-на-длинную-случайную-строку
JWT_EXPIRES_IN=8h
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Адрес сайта — для ссылок в письмах и приглашениях
APP_URL=http://localhost:5173
# Валюта в интерфейсе
CURRENCY=₸
# Часовой пояс: «сегодня», просрочка, статистика и сессия БД считаются в нём
APP_TZ=Asia/Almaty

# Саморегистрация только для адресов этого домена. Пусто — регистрация отключена (только приглашения от админа)
ALLOWED_EMAIL_DOMAIN=
# Срок действия ссылки-приглашения, часов
INVITE_TTL_HOURS=72
# За обратным прокси (Caddy/nginx): 1. Без прокси оставьте пустым, иначе IP клиента можно подделать
TRUST_PROXY=

# Каталог вложений (вне публичной папки; входит в резервную копию)
UPLOAD_DIR=uploads

# Почта. Если SMTP_HOST пуст — письма пишутся в лог (режим разработки)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Заявки в снабжение <no-reply@example.com>

# Первый администратор (создаётся при db:seed). Пустой пароль — будет сгенерирован и показан один раз
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# 1 — добавить демо-пользователей и демо-заявки (только для разработки)
SEED_DEMO=0
